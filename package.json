{
  "name": "pebble-server-time",
  "author": "Sitwon",
  "version": "1.1.0",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Server Time",
    "uuid": "843b504e-eafc-44f3-b4b7-09a7ec7650f6",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": ["emery", "gabbro"],
    "watchapp": { "watchface": true },
    "resources": { "media": [
      { "type": "font", "name": "FONT_TERM_36", "file": "fonts/TerminusTTF-Regular.ttf", "characterRegex": "[0-9:A-Za-z -]" },
      { "type": "font", "name": "FONT_TERM_36_BOLD", "file": "fonts/TerminusTTF-Bold.ttf", "characterRegex": "[:0-9]" },
      { "type": "font", "name": "FONT_TERM_18", "file": "fonts/TerminusTTF-Regular.ttf", "characterRegex": "[0-9-]" },
      { "type": "font", "name": "FONT_TERM_14", "file": "fonts/TerminusTTF-Regular.ttf", "characterRegex": "[A-Za-z ]" }
    ] }
  }
}
